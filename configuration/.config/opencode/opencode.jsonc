{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "providers": {},
    "small_model": "gemma4:e2b",
    "mcp": {
        // src: https://github.com/ChromeDevTools/chrome-devtools-mcp
        "chrome-devtools": {
            "enabled": true,
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--slim",
                "--headless"
            ]
        },
        // https://github.com/microsoft/playwright-mcp
        "playwright": {
            "enabled": true,
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@playwright/mcp@latest",
            ]
        },
    }
}
